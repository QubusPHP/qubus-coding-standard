{
  "name": "qubus/qubus-coding-standard",
  "type": "phpcodesniffer-standard",
  "description": "Qubus Coding Standard",
  "keywords": [
    "qubus",
    "coding standard"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Joshua Parker",
      "email": "josh@joshuaparker.blog",
      "homepage": "https://joshuaparker.dev/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4",
    "squizlabs/php_codesniffer": "^3",
    "slevomat/coding-standard": "^8",
    "webimpress/coding-standard": "^1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1",
    "pestphp/pest": "4.3.2",
    "mockery/mockery": "^1",
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "12.5.8",
    "phpunit/php-code-coverage": "12.5.2",
    "symfony/var-dumper": "^8.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
